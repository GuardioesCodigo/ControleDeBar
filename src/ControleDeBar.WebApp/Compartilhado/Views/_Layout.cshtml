<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">

    <title>Controle de Bar</title>
</head>

<body>
    <header class="bg-primary text-white px-4 py-2">
        <span class="fw-semibold">Dashboard</span>
    </header>

    <div class="container-fluid">
        <div class="row min-vh-100">
            <aside class="col-md-2 col-lg-2 bg-light border-end p-0">
                <nav class="nav flex-column">

                    <a class="nav-link text-dark px-3 py-2"
                       asp-controller="Home"
                       asp-action="Index">
                        Página Inicial
                    </a>          

                    <a class="nav-link text-dark px-3 py-2"
                       asp-controller="Mesa"
                       asp-action="Listar">
                        Mesas
                    </a>

                    <a class="nav-link text-dark px-3 py-2"
                       asp-controller="Garcom"
                       asp-action="Listar">
                        Garçons
                    </a>

                    <a class="nav-link text-dark px-3 py-2"
                       asp-controller="Produto"
                       asp-action="Listar">
                        Produtos
                    </a>

                    <a class="nav-link text-dark px-3 py-2"
                       asp-controller="Conta"
                       asp-action="Listar">
                        Contas
                    </a>

                    <a class="nav-link text-dark px-3 py-2"
                       asp-controller="Faturamento"
                       asp-action="Visualizar">
                        Faturamento
                    </a>

                    <a class="nav-link text-dark px-3 py-2"
                       asp-controller="Estabelecimento"
                       asp-action="Listar">
                        Estabelecimento
                    </a>
                </nav>
            </aside>

            <main class="col-md-10 col-lg-10 p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous">
    </script>
</body>
</html>