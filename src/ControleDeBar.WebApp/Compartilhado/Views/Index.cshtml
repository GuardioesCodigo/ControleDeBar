@using ControleDeBar.WebApp.Compartilhado
@{
    Layout = "_Layout";
}

@model IndexViewModel

<div class="py-2">
    <h2 class="mb-3">Bem-vindo!</h2>

    <p class="mb-3">
        Estabelecimento: <strong>@Model.NomeEstabelecimento</strong>
    </p>

    <a class="btn btn-primary rounded-pill px-4"
       asp-controller="Estabelecimento"
       asp-action="Editar">
        Editar Estabelecimento
    </a>

    <h5 class="mt-4 mb-3">Resumo do dia</h5>

    <div class="card border-dark rounded-4" style="max-width: 420px;">
        <div class="card-body">
            <p class="mb-2">
                Contas abertas: <strong>@Model.ContasAbertas</strong>
            </p>

            <p class="mb-2">
                Faturamento do dia: <strong>@Model.FaturamentoDoDia.ToString("C")</strong>
            </p>

            <p class="mb-0">
                Mesas ocupadas:
                <strong>@Model.MesasOcupadas / @Model.TotalMesas</strong>
            </p>
        </div>
    </div>
</div>