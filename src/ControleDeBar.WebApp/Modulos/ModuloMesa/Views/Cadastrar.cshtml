@using ControleDeBar.WebApp.Modulos.ModuloMesa
@using ControleDeBar.Dominio.Modulos.ModuloMesa;
@{
    Layout = "_Layout";
}

@model CadastrarMesaViewModel

<form asp-action="Cadastrar" method="post" class="col-12 col-md-6">
    <div class="mb-3">
        <label asp-for="Numero" class="form-label">Número</label>
        <input asp-for="Numero" class="form-control" />
        <span asp-validation-for="Numero" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="QuantidadeLugares" class="form-label">Quantidade de Lugares</label>
        <input asp-for="QuantidadeLugares" class="form-control" />
        <span asp-validation-for="QuantidadeLugares" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">Status</label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusMesa>()"></select>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary rounded-pill px-4">Cadastrar</button>
        <a asp-action="Listar" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
    </div>
</form>