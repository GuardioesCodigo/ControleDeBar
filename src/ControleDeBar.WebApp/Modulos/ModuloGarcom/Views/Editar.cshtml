@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Garçom";
}

@model EditarGarcomViewModel;

<form asp-action="Editar" method="post" class="col-12 col-md-6">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger small"></span>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary rounded-pill px-4">Salvar</button>
        <a asp-action="Listar" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
    </div>
</form>
