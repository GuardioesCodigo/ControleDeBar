@using ControleDeBar.WebApp.Modulos.ModuloEstabelecimento
@{
    Layout = "_Layout";
}

@model DetalhesEstabelecimentoViewModel

<div class="card border-0 shadow-sm mx-auto p-4" style="max-width: 620px;">
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted small text-uppercase">Nome</dt>
        <dd class="col-sm-8">@Model.Nome</dd>

        <dt class="col-sm-4 text-muted small text-uppercase">Endereço</dt>
        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Endereco) ? "-" : Model.Endereco)</dd>

        <dt class="col-sm-4 text-muted small text-uppercase">Cadastrado em</dt>
        <dd class="col-sm-8">@Model.DataCriacao.ToString(format: "dd/MM/yyyy")</dd>
    </dl>

    <a class="btn btn-primary rounded-pill mt-3 align-self-end" asp-controller="Estabelecimento" asp-action="Editar">Editar Estabelecimento</a>

    <a class="btn btn-primary rounded-pill mt-3 align-self-end" asp-controller="Estabelecimento" asp-action="Cadastrar" class="btn btn-primary">Cadastrar estabelecimento</a>
</div>
