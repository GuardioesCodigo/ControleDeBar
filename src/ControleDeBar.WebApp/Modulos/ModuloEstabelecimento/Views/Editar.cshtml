@using ControleDeBar.WebApp.Modulos.ModuloEstabelecimento
@{
    Layout = "_Layout";
}

@model EditarEstabelecimentoViewModel

<form class="card border-0 shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" class="form-control">
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Endereco" class="form-label fw-semibold text-primary text-uppercase small">Endereço</label>
        <input asp-for="Endereco" class="form-control">
        <span asp-validation-for="Endereco" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Visualizar">Cancelar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Salvar</button>
    </div>
</form>
