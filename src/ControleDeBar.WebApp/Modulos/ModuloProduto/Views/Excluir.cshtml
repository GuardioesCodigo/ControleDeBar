@using ControleDeBar.WebApp.Modulos.ModuloProduto
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Produto";
}

@model ExcluirProdutoViewModel;

<div class="alert alert-warning border-start border-warning border-4 rounded-3 col-12 col-md-6">
    Tem certeza que deseja excluir o produto <strong>@Model.Nome</strong>? Essa ação não pode ser desfeita.
</div>

<form asp-action="Excluir" method="post" class="col-12 col-md-6">
    <input asp-for="Id" type="hidden" />

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-danger rounded-pill px-4">Excluir</button>
        <a asp-action="Listar" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
    </div>
</form>